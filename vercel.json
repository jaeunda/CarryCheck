{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "includeFiles": "src/airline_baggage_agent/data/**",
      "excludeFiles": "{tests/**,public/**,.venv*/**,**/__pycache__/**,**/*.pyc}"
    }
  },
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
