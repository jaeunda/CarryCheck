    {
      "rule_id": "CN-CAAC-POWER-BANK",
      "country": "China",
      "country_name": "중국",
      "domain": "aviation_safety",
      "direction": "departure",
      "route_scope": "all",
      "item_type": "power_bank",
      "keywords": ["보조배터리", "파워뱅크", "power bank"],
      "status": "conditional",
      "rule_text": "중국 민항국은 보조배터리를 기내 수하물로만 허용한다. 100Wh 이하는 항공사 승인 없이 가능하고, 100Wh 초과 160Wh 이하는 항공사 승인 후 최대 2개이며, 160Wh 초과 또는 용량을 확인할 수 없는 제품은 금지한다. 비행 중 충전용 사용도 금지한다.",
      "conditions": ["보조배터리는 기내에만 휴대한다.", "100Wh 초과 160Wh 이하는 항공사 승인을 받는다.", "비행 중 보조배터리로 다른 전자기기를 충전하지 않는다."],
      "source_title": "CAAC Notice on Passenger Carriage of Power Banks",
      "source_url": "https://www.caac.gov.cn/XXGK/XXGK/TZTG/201511/t20151105_11173.html",
      "effective_from": "2014-08-07",
      "verified_date": "2026-08-05"
    },
    {
      "rule_id": "CN-CAAC-CCC-DOMESTIC-2025",
      "country": "China",
      "country_name": "중국",
      "domain": "aviation_safety",
      "direction": "departure",
      "route_scope": "domestic",
      "item_type": "power_bank",
      "keywords": ["보조배터리", "파워뱅크", "power bank", "3C", "CCC"],
      "status": "conditional",
      "rule_text": "2025년 6월 28일부터 중국 국내선은 CCC(3C) 표시가 없거나 불명확한 보조배터리와 리콜 대상 모델·배치를 기내에 반입할 수 없다.",
      "conditions": ["제품 본체의 CCC(3C) 표시가 명확해야 한다.", "리콜 대상 모델 또는 배치가 아니어야 한다."],
      "source_title": "CAAC Bans Power Banks Without CCC Markings on Domestic Flights",
      "source_url": "https://www.caac.gov.cn/English/News/202507/t20250709_227894.html",
      "effective_from": "2025-06-28",
      "verified_date": "2026-08-05"
    },
    {
      "rule_id": "CN-CAAC-LIQUID-DOMESTIC",
      "country": "China",
      "country_name": "중국",
      "domain": "aviation_safety",
      "direction": "departure",
      "route_scope": "domestic",
      "item_type": "liquid",
      "keywords": ["액체", "화장품", "로션", "샴푸", "치약", "면도 크림", "liquid"],
      "status": "conditional",
      "rule_text": "중국 국내선은 일반 액체류의 기내 반입을 제한한다. 여행 중 사용하는 화장품은 종류별 1개, 용기당 100mL 이하이고 개봉 검사를 받아야 한다. 치약과 면도용 젤·크림도 종류별 1개, 100g 또는 100mL 이하만 가능하다.",
      "conditions": ["여행용 화장품은 종류별 1개만 휴대한다.", "개별 용기는 100mL 또는 100g 이하여야 한다.", "보안검색에서 개봉 검사를 받을 수 있다."],
      "source_title": "CAAC Air Travel Guidance — Liquid Articles",
      "source_url": "https://www.caac.gov.cn/big5/www.caac.gov.cn/INDEX/HLFW/HKLXCS/202303/t20230316_217597.html",
      "effective_from": null,
      "verified_date": "2026-08-05"
    },
