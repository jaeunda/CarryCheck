    {
      "rule_id": "TH-CAAT-LITHIUM-BATTERY",
      "country": "Thailand",
      "country_name": "태국",
      "domain": "aviation_safety",
      "direction": "departure",
      "route_scope": "all",
      "item_type": "power_bank",
